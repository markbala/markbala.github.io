# Security headers for all paths.
# HSTS (Strict-Transport-Security) is deliberately NOT set here: ownership and
# TLS readiness of all subdomains of balakrishnan.sg is unproven, and a
# includeSubDomains/preload policy is hard to reverse. Revisit once confirmed
# (preferably set at the Cloudflare edge).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; media-src 'self'; frame-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# HTML: revalidate quickly. Scoped to HTML paths (not /*) so it does not get
# merged with the asset rules below.
/
  Cache-Control: public, max-age=300, s-maxage=300
  Link: </css/site.css>; rel=preload; as=style
  Link: </js/site.js>; rel=preload; as=script
/*.html
  Cache-Control: public, max-age=300, s-maxage=300
/projects/*
  Cache-Control: public, max-age=300, s-maxage=300

# CSS/JS filenames are unversioned: short cache with revalidation.
/css/*
  Cache-Control: public, max-age=3600, must-revalidate
/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# Images/video: moderate cache, not immutable.
/img/*
  Cache-Control: public, max-age=86400
/videos/*
  Cache-Control: public, max-age=86400
